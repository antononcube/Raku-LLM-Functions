use v6.d;

use Test;
use LLM::Functions;
use LLM::Tooling;

plan *;

my Int $add-calls = 0;

#| Add two integers.
sub add(Int:D $left, Int:D $right --> Int:D) {
    $add-calls++;
    $left + $right
}

class TestChatEvaluator is LLM::Functions::EvaluatorChat {
    has Bool $.tool-path-used is rw = False;

    multi method eval(@messages, *%args) {
        'ordinary response'
    }

    method eval-with-tools(@messages, *%args --> Hash) {
        $!tool-path-used = True;

        my $request = LLM::ToolRequest.new('add', %('$left' => 19, '$right' => 23));
        my $response = generate-llm-tool-response(self.conf.tools[0], $request);

        return %(
                result => '19 plus 23 is 42.',
                messages => [
                    %(
                            role => 'assistant',
                            tool_calls => [
                                %(
                                        id => 'call-add',
                                        function => %(
                                                name => 'add',
                                                arguments => '{"$left":19,"$right":23}'))]),
                    %(role => 'tool', name => 'add', tool_call_id => 'call-add', content => $response.output.Str),
                    %(role => 'assistant', content => '19 plus 23 is 42.')
                ]);
    }
}

subtest {
    my $tool = LLM::Tool.new(&add);
    my $configuration = llm-configuration('ChatGPT', tools => [$tool]);
    my $evaluator = TestChatEvaluator.new(conf => $configuration);
    my $chat = LLM::Functions::Chat.new(
            chat-id => 'tool-chat',
            llm-evaluator => $evaluator);

    is $chat.eval('What is 19 plus 23?'), '19 plus 23 is 42.',
            'chat returns the final tool-aware response';
    ok $evaluator.tool-path-used, 'chat selects eval-with-tools when configuration has tools';
    is $add-calls, 1, 'configured local tool was invoked';
    is-deeply $chat.messages.map(*<role>).Array, ['user', 'assistant', 'tool', 'assistant'],
            'chat records the user message, tool call, tool result, and final answer';
    is $chat.messages[2]<content>, '42', 'tool result is retained in the transcript';
    ok $chat.messages[1]<timestamp>:exists, 'generated tool-call message receives a timestamp';
}, 'Chat evaluation with configured tools';

subtest {
    my $configuration = llm-configuration('ChatGPT', tools => []);
    my $evaluator = TestChatEvaluator.new(conf => $configuration);
    my $chat = LLM::Functions::Chat.new(
            chat-id => 'ordinary-chat',
            llm-evaluator => $evaluator);

    is $chat.eval('Hello'), 'ordinary response', 'chat returns its ordinary evaluator response';
    nok $evaluator.tool-path-used, 'chat does not select the tool path without configured tools';
    is-deeply $chat.messages.map(*<role>).Array, ['user', 'assistant'],
            'ordinary chats retain their original transcript shape';
}, 'Chat evaluation without configured tools';

done-testing;
