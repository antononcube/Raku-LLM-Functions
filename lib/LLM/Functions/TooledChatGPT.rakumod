use v6.d;

use LLM::Tooling;
use LLM::Functions::Tooled;
use WWW::OpenAI;
use JSON::Fast;

class LLM::Functions::TooledChatGPT is LLM::Functions::Tooled {

    method normalize-tool-spec(%spec is copy) {

        if !(%spec<type>:exists) || !(%spec<function>:exists) {
            %spec = type => 'function', function => $_;
        }

        # Without normalization ChatGPT will return the message:
        # > Invalid schema for function 'js-d3-random-mondrian': In context=(), 'required' is required to be supplied and to be an array including every key in properties.

        if %spec<function><parameters>:exists {
            if %spec<function><parameters><properties>.elems > %spec<function><parameters><required>.elems {
                %spec<function><parameters><required> = %spec<function><parameters><properties>.keys.Array
            }
        }

        return %spec;
    }

    # Helper: extract ToolRequests from a Gemini candidate content
    method extract-tool-requests(%assistant-content) {
        my @requestObjects;
        if %assistant-content<tool_calls> {
            for |%assistant-content<tool_calls> -> %part {
                if %part<function> && %part<function><name> {
                    my $name = %part<function><name>;
                    my %args = %part<function><arguments> ~~ Str:D ?? from-json(%part<function><arguments>) !! %part<function><arguments>;
                    @requestObjects.push( LLM::ToolRequest.new(:$name, :%args, id => %part<id> ) ) ;
                }
            }
        }
        return @requestObjects;
    }

    #| Synthesize with tools in a loop until the LLM returns a final, non-tool response.
    #| Arg 1 ($prompt): Str with the user messages.
    #| Arg 2 (@tool-objects): Array of LLM::Tool objects (callable tool implementations).
    multi method eval(@texts, *%args) {

        # Clone configuration
        my $confLocal = self.conf.clone;

        # Make "full" prompt
        my $prompt = $confLocal.prompts.join($confLocal.prompt-delimiter).trim;
        $prompt = self.prompt-texts-combiner($prompt, @texts);

        # Normalize the prompt-oriented API into a one-message chat.
        my @messages = [%( role => 'user', content => $prompt ), ];
        return self.eval-chat(@messages, |%args)<result>;
    }

    #| Evaluate a structured Chat Completions transcript with tools.
    #| Returns the final result and only the messages generated by this call.
    multi method eval-chat(@messages where @messages.all ~~ Map:D, *%args --> Hash) {

        # To echo or not
        my $echo = %args<echo> // False;

        # Clone configuration
        my $confLocal = self.conf.clone;

        note "Configuration : { $confLocal.gist }" if $echo;

        # Get parameters
        my @tool-objects = |%args<tool-objects>;
        die 'The value of :@tool-objects is expected to be a list of LLM::Tool objects.'
        unless @tool-objects.all ~~ LLM::Tool:D;

        my @tool-specs = %args<tool-specs> // Empty;
        my $max-iterations = %args<max-iterations> // 8;

        # Strip transcript-only fields, such as timestamps, before sending
        # provider messages.
        my @provider-messages = @messages.map({
            $_.grep({ $_.key ∈ <role content tool_calls tool_call_id name> }).Hash
        }).Array;
        my @generated-messages;

        # Get tool specifications, either explicitly or from LLM::Tool objects.

        if !@tool-specs.elems {
            @tool-specs = @tool-objects.map({ llm-tool-definition($_.info, format => 'hash', :!warn) });
        }

        # Adjust specs to OpenAI's peculiar format
        @tool-specs .= map({ self.normalize-tool-spec($_) });

        # Normalize and exclude parameters
        my %args2 = $confLocal.normalize-params(%args, <prompt prompts tools format echo tool-config tool-objects>);

        # Proclaim
        note "Normalized additional parameters => {%args2.raku}" if $echo;

        # First call
        my $response = openai-chat-completion(
                @provider-messages,
                tools => @tool-specs,
                format => 'hash',
                |%args2);


        # Safety loop
        my $iterations = 0;

        loop {
            $iterations++;
            note "LLM invocation : $iterations" if $echo;

            if $iterations > $max-iterations {
                die "LLM execution with tools exceeded max loops ($max-iterations).";
            }

            note (:$response) if $echo;

            # This adapter deliberately supports Chat Completions only. The
            # Responses API has a different, typed output-item protocol.
            die 'TooledChatGPT received a non-Chat-Completions response; Responses API support is not implemented yet.'
            unless $response ~~ Positional:D
                    && $response.elems
                    && $response[0] ~~ Map:D
                    && $response[0]<message> ~~ Map:D;

            my %assistant-message = $response[0]<message>.Hash;

            # 4) If the LLM returned tool-call(s), run them locally and continue
            my @requests = self.extract-tool-requests(%assistant-message);

            if @requests.elems {

                my %assistant-record = role => 'assistant', tool_calls => %assistant-message<tool_calls>;
                with %assistant-message<content> { %assistant-record<content> = .Str; }
                @provider-messages.push(%assistant-record);
                @generated-messages.push(%assistant-record);

                # 4.1–4.3 Compute with the tools and add functionResponse messages
                my @funcParts = @requests.map({ generate-llm-tool-response(@tool-objects, $_) })».Hash('ChatGPT');

                if $echo {
                    note 'Tool responses:';
                    .note for @funcParts;
                }

                # Make and add the user response
                for @funcParts {
                    $_<content> .= Str;
                    @provider-messages.push($_);
                    @generated-messages.push($_.Hash);
                }

                # 4.5 goto loop (send back to the LLM)
                # Send the second request with function result
                $response = openai-chat-completion(
                        @provider-messages,
                        tools => @tool-specs,
                        format => 'hash',
                        |%args2);

                next;
            }

            # No tool calls — append and return the final assistant message.
            my $content = %assistant-message<content> // '';
            my %assistant-record = role => 'assistant', content => $content.Str;
            @generated-messages.push(%assistant-record);
            return %(result => $content, messages => @generated-messages.Array);
        }
    }
}
