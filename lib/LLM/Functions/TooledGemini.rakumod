use v6.d;

use LLM::Tooling;
use LLM::Functions::Tooled;
use WWW::Gemini;
use JSON::Fast;

class LLM::Functions::TooledGemini is LLM::Functions::Tooled {

    method normalize-tool-spec(%spec is copy) {
        if %spec<function>:exists { %spec = %spec<function> }

        # Just calling :delete should be fine, but I want be explicit
        if %spec<type>:exists { %spec<type>:delete }
        if %spec<strict>:exists { %spec<strict>:delete }

        # Clean
        if %spec<parameters>:exists {
            %spec<parameters><additionalProperties>:delete;
            %spec<parameters><type>:delete;
            %spec<parameters><type> = 'object';
        }

        return %spec;
    }

    # Helper: extract ToolRequests from a Gemini candidate content
    method extract-tool-requests(%assistant-content) {
        my @requestObjects;
        if %assistant-content<parts> {
            for |%assistant-content<parts> -> %part {
                if %part<functionCall> && %part<functionCall><name> {
                    my $name = %part<functionCall><name>;
                    my %args = (%part<functionCall><args> // {}).Hash;
                    @requestObjects.push: LLM::ToolRequest.new($name, %args);
                }
            }
        }
        return @requestObjects;
    }

    # Convert the provider-neutral transcript held by Chat into Gemini
    # GenerateContent messages. Gemini represents assistant messages as
    # C<model> and function results as user parts.
    method provider-message(%message --> Hash) {
        my $role = %message<role> // 'user';

        if $role eq 'tool' {
            my $name = %message<name> // %message<tool> // '';
            return %(
                    role => 'user',
                    parts => [%(functionResponse => %(
                            name => $name,
                            response => %(content => (%message<content> // '').Str)))])
        }

        if ($role eq 'assistant') && (%message<tool_calls>:exists) {
            my @parts = %message<tool_calls>.map(-> %call {
                my %function = %call<function> // %();
                my $arguments = %function<arguments> // %();
                $arguments = from-json($arguments) if $arguments ~~ Str:D;
                %(functionCall => %(
                        name => %function<name>,
                        args => $arguments))
            });
            return %(role => 'model', :@parts);
        }

        return %(
                role => ($role eq 'assistant' ?? 'model' !! 'user'),
                parts => [%(text => (%message<content> // '').Str)]);
    }

    #| Synthesize with tools in a loop until the LLM returns a final, non-tool response.
    #| Arg 1 ($prompt): Str with the user messages.
    #| Arg 2 (@tool-objects): Array of LLM::Tool objects (callable tool implementations).
    multi method eval(@texts, *%args) {
        my $confLocal = self.conf.clone;

        # Make "full" prompt
        my $prompt = $confLocal.prompts.join($confLocal.prompt-delimiter).trim;
        $prompt = self.prompt-texts-combiner($prompt, @texts);

        my @messages = [%(role => 'user', content => $prompt),];
        return self.eval-chat(@messages, |%args)<result>;
    }

    #| Evaluate a structured Gemini chat transcript with tools.
    #| Returns the final result and only the messages generated by this call.
    multi method eval-chat(@messages where @messages.all ~~ Map:D, *%args --> Hash) {

        my $echo = %args<echo> // False;
        my $confLocal = self.conf.clone;

        note "Configuration : { $confLocal.gist }" if $echo;

        my @tool-objects = |%args<tool-objects>;
        die 'The value of :@tool-objects is expected to be a list of LLM::Tool objects.'
        unless @tool-objects.all ~~ LLM::Tool:D;

        my @tool-specs = %args<tool-specs> // Empty;
        my %tool-config = %args<tool-config> // $confLocal.tool-config // { functionCallingConfig => { mode => "ANY" } };
        my $max-iterations = %args<max-iterations> // 8;
        my @provider-messages = @messages.map({ self.provider-message($_.Hash) }).Array;
        my @generated-messages;

        # Get tool specifications, either explicitly or from LLM::Tool objects.

        if !@tool-specs.elems {
            @tool-specs = @tool-objects.map({ llm-tool-definition($_.info, format => 'hash', :!warn) });
        }

        @tool-specs .= map({ self.normalize-tool-spec($_) });

        # Normalize and exclude parameters
        my %args2 = $confLocal.normalize-params(%args, <prompt prompts tools format echo tool-config tool-objects>);

        # Proclaim
        note "Normalized additional parameters => {%args2.raku}" if $echo;

        # First call
        my $response = gemini-generate-content(
                @provider-messages,
                tools => @tool-specs,
                :%tool-config,
                format => 'hash',
                |%args2);

        # Safety loop
        my $iterations = 0;

        loop {
            $iterations++;
            note "LLM invocation : $iterations" if $echo;

            if $iterations > $max-iterations {
                die "LLM execution with tools exceeded max loops ($max-iterations).";
            }

            note (:$response) if $echo;

            die 'TooledGemini received a response without a candidate content message.'
            unless $response ~~ Map:D
                    && $response<candidates> ~~ Positional:D
                    && $response<candidates>.elems
                    && $response<candidates>[0]<content> ~~ Map:D;

            my %assistant-message = $response<candidates>[0]<content>.Hash;

            # 4) If the LLM returned tool-call(s), run them locally and continue
            my @requests = self.extract-tool-requests(%assistant-message);

            if @requests.elems {
                @provider-messages.push(%assistant-message);

                my @tool-calls = %assistant-message<parts>.grep({ $_<functionCall>:exists }).map(-> %part {
                    my %call = %part<functionCall>;
                    %(id => '', function => %(
                            name => %call<name>,
                            arguments => %call<args> // %()))
                }).Array;
                @generated-messages.push(%(role => 'assistant', tool_calls => @tool-calls));

                # 4.1–4.3 Compute with the tools and add functionResponse messages
                my @tool-responses = @requests.map({ generate-llm-tool-response(@tool-objects, $_) });
                my @funcParts = @tool-responses».Hash('Gemini');

                if $echo {
                    note 'Tool responses:';
                    .note for @funcParts;
                }

                # Make and add the function response.
                my %function-response =
                        role => 'user',
                        parts => @funcParts;

                @provider-messages.push(%function-response);
                for @tool-responses -> $tool-response {
                    @generated-messages.push(%(
                            role => 'tool',
                            name => $tool-response.tool,
                            content => ($tool-response.output // '').Str));
                }

                # 4.5 goto loop (send back to the LLM)
                # Send the second request with function result
                $response = gemini-generate-content(
                        @provider-messages,
                        tools => @tool-specs,
                        format => 'hash',
                        |%args2);

                next;
            }

            # No tool calls — append and return the final assistant message.
            my $content = %assistant-message<parts>
                    .grep({ $_<text>:exists })
                    .map(*<text>.Str)
                    .join("\n");
            @generated-messages.push(%(role => 'assistant', content => $content));
            return %(result => $content, messages => @generated-messages.Array);
        }
    }
}
