use v6.d;

use Test;
use LLM::Functions;
use LLM::Tooling;

plan *;

#my $model = 'gpt-4.1-mini';
my $model = 'gpt-5.6-luna';

my Int $add-calls = 0;

#| Add two integers.
sub add(Int:D $left, Int:D $right --> Int:D) {
    $add-calls++;
    $left + $right
}

my $add-tool = LLM::Tool.new(&add);
my $api-key = %*ENV<OPENAI_API_KEY> // Whatever;

# The tool list belongs to the configuration, which is then used to make the
# chat object. It is not supplied to the synthesis call.
my $configuration = llm-configuration(
        'ChatGPT',
        :$model,
        tools => [$add-tool,],
        :$api-key,
        temperature => 0,
        max-tokens => 64,
        reasoning-effort => 'none'
        );

my $chat = llm-chat(
        chat-id => 'configured-tools-chat',
        llm-evaluator => $configuration);

isa-ok $chat, LLM::Functions::Chat, 'a chat object is created from the configuration';
is $chat.llm-evaluator.conf.tools.elems, 1, 'the chat configuration has one tool';
is $chat.llm-evaluator.conf.tools[0].info<name>, 'add', 'the configured tool is add';

# Verify local dispatch independently of the service call.
my $request = LLM::ToolRequest.new('add', %('$left' => 19, '$right' => 23));
is generate-llm-tool-response($add-tool, $request).output, 42,
        'the configured tool can be invoked locally';

# A live request is deliberately opt-in because it needs credentials and can
# incur cost. The chat configuration is the only source of tools.
if ((%*ENV<RUN_LIVE_TOOLS_TEST> // '') eq '1') && $api-key ~~ Str:D && $api-key.chars {
    $add-calls = 0;
    my $answer = $chat.eval(
            'You must call the add tool; do not calculate yourself. What is 19 plus 23?');

    ok $add-calls > 0, 'chat.eval invoked the tool from its configuration';
    ok $answer.Str.contains('42'), 'the final answer includes the tool result';
    is $chat.messages.elems, 2, 'the chat records the user message and answer';
} else {
    skip 'Set OPENAI_API_KEY and RUN_LIVE_TOOLS_TEST=1 to run the configured-tools test.', 3;
}

done-testing;
